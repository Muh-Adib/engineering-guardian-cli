{
  "name": "engineering-guardian-cli",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": { "eg": "./dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "scan": "tsx src/index.ts scan",
    "verify": "tsx src/index.ts verify",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "self-scan": "tsx src/index.ts scan"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
